# SecureOps production template. Copy to .env.production and fill every secret.
ENVIRONMENT=production

MYSQL_DATABASE=security_platform
MYSQL_USER=security_user
MYSQL_PASSWORD=<generate-a-strong-password>
MYSQL_ROOT_PASSWORD=<generate-a-different-strong-root-password>
JWT_SECRET_KEY=<generate-a-random-secret-at-least-32-characters>

FRONTEND_PORT=8080
SEED_DEMO_DATA=false
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Replace with the real browser origin(s); do not leave broad wildcards.
CORS_ORIGINS=http://your-server-address:8080

LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOG_FILE=logs/security-platform.log

# Compose injects the internal Redis hostname into backend services.
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Optional NVD integration.
NVD_API_KEY=
NVD_SYNC_DAYS=7
